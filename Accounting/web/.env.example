# web/.env — local development credentials
# Copy this file to web/.env and fill in your values.
# NEVER commit web/.env to git — it contains real credentials.
# Add 'web/.env' to your .gitignore.

# ── Database ──────────────────────────────────────────────────────
# Get your RDS endpoint:
#   cd Deployed/aws-deployment
#   terraform output database_endpoint
#
# Then fill in below:
DATABASE_URL=postgresql://admin:SecurePassword123!@<RDS_ENDPOINT_HERE>:5432/ethiopian_business

# If you want to test against a LOCAL PostgreSQL instead of RDS:
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/ethiopian_business

# ── Flask ─────────────────────────────────────────────────────────
FLASK_SECRET_KEY=local-dev-only-not-for-production
FLASK_DEBUG=1

# ── Optional: AWS region (used by some routes for S3/SES) ─────────
# AWS_REGION=af-south-1
